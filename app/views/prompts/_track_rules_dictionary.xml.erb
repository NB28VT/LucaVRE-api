<track_dictionary>
  <track_key_mapping>
    <% @track_key_mapping.each do |abbreviation, description| %>
      <track_key>
        <key><%= abbreviation %></key>
        <value><%= description %></value>
      </track_key>
    <% end %>
  </track_key_mapping>
  <downforce_requirement_mapping>
    <% @downforce_requirement_mapping.each do |abbreviation, description| %>
      <downforce_requirement>
        <key><%= abbreviation %></key>
        <value><%= description %></value>
      </downforce_requirement>
    <% end %>
  </downforce_requirement_mapping>
  <surface_roughness_mapping>
    <% @surface_roughness_mapping.each do |abbreviation, description| %>
      <surface_roughness>
        <key><%= abbreviation %></key>
        <value><%= description %></value>
      </surface_roughness>
    <% end %>
  </surface_roughness_mapping>
  <curb_intensity_mapping>
    <% @curb_intensity_mapping.each do |abbreviation, description| %>
      <curb_intensity>
        <key><%= abbreviation %></key>
        <value><%= description %></value>
      </curb_intensity>
    <% end %>
  </curb_intensity_mapping>
  <primary_characteristic_mapping>
    <% @primary_characteristic_mapping.each do |abbreviation, description| %>
      <primary_characteristic>
        <key><%= abbreviation %></key>
        <value><%= description %></value>
      </primary_characteristic>
    <% end %>
  </primary_characteristic_mapping>
</track_dictionary>