<handling_deficit_dictionary>
  <handling_deficit_key_mapping>
    <% @handling_deficit_key_mapping.each do |abbreviation, description| %>
      <handling_deficit_key>
        <key><%= abbreviation %></key>
        <value><%= description %></value>
      </handling_deficit_key>
    <% end %>
  </handling_deficit_key_mapping>
  <handling_deficit_location_mapping>
    <% @handling_deficit_location_mapping.each do |abbreviation, description| %>
      <handling_deficit_location>
        <key><%= abbreviation %></key>
        <value><%= description %></value>
      </handling_deficit_location>
    <% end %>
  </handling_deficit_location_mapping>
  <handling_deficit_phase_mapping>
    <% @handling_deficit_phase_mapping.each do |abbreviation, description| %>
      <handling_deficit_phase>
        <key><%= abbreviation %></key>
        <value><%= description %></value>
      </handling_deficit_phase>
    <% end %>
  </handling_deficit_phase_mapping>
  <handling_deficit_symptom_mapping>
    <% @handling_deficit_symptom_mapping.each do |abbreviation, description| %>
      <handling_deficit_symptom>
        <key><%= abbreviation %></key>
        <value><%= description %></value>
      </handling_deficit_symptom>
    <% end %>
  </handling_deficit_symptom_mapping>
</handling_deficit_dictionary>